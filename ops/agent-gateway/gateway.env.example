# HIVE Agent Gateway runtime configuration.
# Copy to /etc/hive-agent-gateway/gateway.env with mode 0600.
# NEVER commit real secret values.

HIVE_AGENT_BRIDGE_HOST=127.0.0.1
HIVE_AGENT_BRIDGE_PORT=9240
HIVE_AGENT_BRIDGE_ATTEMPTS=2
HIVE_AGENT_BRIDGE_JOB_TTL_MS=3600000
HIVE_AGENT_BRIDGE_TOKEN=

# Optional public verification path. Leave blank until the stable Named Tunnel
# hostname and Cloudflare Access service credentials are configured.
HIVE_AGENT_GATEWAY_PUBLIC_URL=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

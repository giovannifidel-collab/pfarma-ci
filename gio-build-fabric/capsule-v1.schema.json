{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gio-os.invalid/build-capsule-v1.schema.json",
  "title": "gio Build Capsule v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","capsule_id","kind","target","source","toolchain","outputs","provenance"],
  "properties": {
    "schema": {"const": 1},
    "capsule_id": {"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{2,127}$"},
    "kind": {"enum":["kernel","host-tool","policy","native-library","android-module","partition","rom"]},
    "target": {"type":"string","minLength":1,"maxLength":128},
    "source": {
      "type":"object","additionalProperties":false,
      "required":["repo","sha"],
      "properties": {
        "repo":{"type":"string","pattern":"^https://"},
        "sha":{"type":"string","pattern":"^[0-9a-f]{40}$"}
      }
    },
    "toolchain": {
      "type":"object","additionalProperties":false,
      "required":["name","version","source_sha"],
      "properties": {
        "name":{"type":"string","minLength":1},
        "version":{"type":"string","minLength":1},
        "source_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"}
      }
    },
    "outputs": {
      "type":"array","minItems":1,
      "items": {
        "type":"object","additionalProperties":false,
        "required":["path","sha256","bytes"],
        "properties": {
          "path":{"type":"string","minLength":1},
          "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
          "bytes":{"type":"integer","minimum":1}
        }
      }
    },
    "provenance": {
      "type":"object","additionalProperties":false,
      "required":["worker_repo","workflow_run","commit_sha","private_source_present"],
      "properties": {
        "worker_repo":{"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "workflow_run":{"type":"integer","minimum":1},
        "commit_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
        "private_source_present":{"const":false}
      }
    }
  }
}

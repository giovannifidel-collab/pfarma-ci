{
  "version": 6,
  "protocol": "RAZZO",
  "dynamicPortfolio": true,
  "totalNormalSlots": 64,
  "totalBurstSlots": 1000,
  "defaults": {
    "enabled": true,
    "protectMain": true,
    "taskGraphPath": "factory/task-graph.json",
    "projectManifestCandidates": [".razzo/project.json", "factory/project.json"],
    "policyCandidates": ["factory/policy.json", ".razzo/policy.json"],
    "executorCandidates": ["factory/executor", "factory/executor.py", "factory/executor.ts"],
    "productFirst": true,
    "selfReplan": true,
    "continuousDiscovery": true,
    "readyZeroMeansStop": false
  },
  "projects": [
    {
      "id": "project-giovanni",
      "repository": "giovannifidel-collab/project-giovanni",
      "enabled": true,
      "integrationLane": "integration/razzo",
      "taskGraphPath": "factory/task-graph.json",
      "normalConcurrency": 20,
      "burstConcurrency": 300,
      "protectMain": true,
      "sourceRefFile": "project-giovanni-source-ref.txt",
      "portfolioRefFile": "razzo/project-giovanni-ref.txt",
      "factoryTest": "npm run test:factory --if-present",
      "factoryPlan": "npm run factory:plan --if-present"
    },
    {
      "id": "pfarma-cloud",
      "repository": "giovannifidel-collab/pfarma-cloud",
      "enabled": true,
      "integrationLane": "integration/razzo",
      "taskGraphPath": "factory/task_graph.json",
      "normalConcurrency": 20,
      "burstConcurrency": 350,
      "protectMain": true,
      "sourceRefFile": "source-ref.txt",
      "portfolioRefFile": "razzo/pfarma-ref.txt",
      "factoryTest": "python -m unittest factory.test_razzo_executor && for f in tests/test_stock_threshold_preview.py tests/test_interwarehouse_transfer_preview.py; do [ ! -f \"$f\" ] || python \"$f\"; done",
      "factoryPlan": "python -m factory.plan"
    },
    {
      "id": "family-cloud",
      "repository": "giovannifidel-collab/family-cloud",
      "enabled": true,
      "integrationLane": "agent/bootstrap-family-cloud",
      "taskGraphPath": "factory/task-graph.json",
      "normalConcurrency": 24,
      "burstConcurrency": 350,
      "protectMain": true,
      "sourceRefFile": "family-cloud-ref.txt",
      "portfolioRefFile": "family-cloud-ref.txt",
      "factoryTest": "npm test",
      "factoryPlan": "npm run factory:plan"
    }
  ],
  "onboarding": {
    "rule": "Add or enable a project here; do not edit the AVANZA TUTTO operator command or scheduled task prompts.",
    "minimumFields": ["id", "repository", "enabled"],
    "recommendedFields": ["integrationLane", "taskGraphPath", "normalConcurrency", "burstConcurrency", "portfolioRefFile"]
  }
}

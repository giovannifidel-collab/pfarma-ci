#!/usr/bin/env python3
import json
import os
import re
import sys
from pathlib import Path

if len(sys.argv) >= 4 and sys.argv[1] == "ls-remote":
    url = sys.argv[2]
    requested_ref = sys.argv[3]
    match = re.search(r"github\.com/([^/]+/[^/.]+)(?:\.git)?$", url)
    if match:
        repository = match.group(1)
        portfolio = json.loads(Path("razzo/projects.json").read_text(encoding="utf-8"))
        project = next((p for p in portfolio.get("projects", []) if p.get("repository") == repository), None)
        if project:
            ref_path = project.get("portfolioRefFile") or project.get("sourceRefFile")
            if ref_path:
                path = Path(ref_path)
                if not path.exists():
                    path = Path("razzo") / Path(ref_path).name
                if path.exists():
                    sha = path.read_text(encoding="utf-8").strip().split()[0]
                    print(f"{sha}\t{requested_ref}")
                    raise SystemExit(0)

os.execv("/usr/bin/git", ["git", *sys.argv[1:]])

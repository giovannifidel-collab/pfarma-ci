{
  "version": 1,
  "fabric": "RAZZO_SUPER_FACTORY",
  "controlPlane": "giovannifidel-collab/pfarma-ci",
  "owner": "giovannifidel-collab",
  "repositoryPrefix": "razzo-shard-",
  "logicalShardCapacity": 1000,
  "discovery": {
    "dynamic": true,
    "requirePublic": true,
    "namePattern": "^razzo-shard-[0-9]{4}$",
    "neverAssumeRepositoryExists": true
  },
  "activation": {
    "mode": "adaptive-progressive",
    "initialActiveLimit": 20,
    "stages": [20, 40, 80, 160, 320, 640, 1000],
    "increaseOnlyOnMeasuredThroughputGain": true,
    "decreaseOnBackpressureOrRegression": true,
    "neverEquateRepositoryCountWithRunningConcurrency": true
  },
  "phenotypes": [
    "DISCOVER",
    "BUILD",
    "TEST",
    "COMPOSE_TISSUE",
    "COMPOSE_ORGAN",
    "COMPOSE_SYSTEM",
    "VERIFY_ORGANISM",
    "FAULT",
    "SECURITY",
    "PERFORMANCE",
    "INTEGRATION"
  ],
  "composition": {
    "enabled": true,
    "hierarchy": ["cell", "tissue", "organ", "system", "organism"],
    "promoteOnlyAfterChildVerification": true,
    "requireEmergentVerificationAtEveryParent": true,
    "prioritizeHighestLevelFunctionalDeficit": true
  },
  "scheduling": {
    "fungibleShards": true,
    "collisionDomainLeaseRequired": true,
    "exactShaRequired": true,
    "immutableInputRefRequired": true,
    "integrationSerializedByCollisionDomain": true,
    "humanGatesActionScoped": true,
    "backpressureAware": true,
    "productFirst": true
  },
  "publicShardBoundary": {
    "allowPrivateSourceMaterialization": false,
    "allowSecrets": false,
    "allowRealCustomerOrFamilyData": false,
    "allowCredentials": false,
    "allowedPayloadClasses": [
      "task-contract",
      "non-sensitive-metadata",
      "exact-sha-reference",
      "verification-contract",
      "receipt",
      "timing-metrics"
    ]
  },
  "optimizer": {
    "objective": "maximize verified product utility per wall-clock while preserving correctness, safety, resumability and organic composition",
    "metrics": [
      "verified_product_integrations_per_hour",
      "generation_to_generation_seconds",
      "queue_wait_seconds",
      "collision_rate",
      "candidate_failure_rate",
      "retry_rate",
      "backpressure_rate",
      "time_to_tissue_seconds",
      "time_to_organ_seconds",
      "time_to_system_seconds",
      "time_to_organism_seconds"
    ]
  }
}

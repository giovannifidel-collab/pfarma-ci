{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["analysis", "plan"],
  "properties": {
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysisConfidence", "imageQuality", "priorities", "limitations", "summary"],
      "properties": {
        "analysisConfidence": { "type": "string", "enum": ["low", "medium", "high"] },
        "imageQuality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["front", "side", "back"],
          "properties": {
            "front": { "type": "string", "enum": ["usable", "limited", "unusable"] },
            "side": { "type": "string", "enum": ["usable", "limited", "unusable"] },
            "back": { "type": "string", "enum": ["usable", "limited", "unusable"] }
          }
        },
        "priorities": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["area", "observation", "confidence", "trainingImplication"],
            "properties": {
              "area": {
                "type": "string",
                "enum": [
                  "v_taper",
                  "waist_contrast",
                  "shoulder_width",
                  "lat_width",
                  "upper_back",
                  "upper_chest",
                  "chest",
                  "arms_proportion",
                  "arms",
                  "core",
                  "recomposition",
                  "symmetry_visual",
                  "legs",
                  "overall_balance"
                ]
              },
              "observation": { "type": "string", "maxLength": 500 },
              "confidence": { "type": "string", "enum": ["low", "medium"] },
              "trainingImplication": { "type": "string", "maxLength": 500 }
            }
          }
        },
        "limitations": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "maxLength": 300 } },
        "summary": { "type": "string", "maxLength": 600 }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "rationale", "safetyNote", "days"],
      "properties": {
        "summary": { "type": "string", "maxLength": 800 },
        "rationale": { "type": "array", "minItems": 3, "maxItems": 8, "items": { "type": "string", "maxLength": 500 } },
        "safetyNote": { "type": "string", "maxLength": 800 },
        "days": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["day", "title", "durationMinutes", "emphasis", "warmupMinutes", "exercises", "finisher"],
            "properties": {
              "day": { "type": "integer", "minimum": 1, "maximum": 6 },
              "title": { "type": "string", "maxLength": 120 },
              "durationMinutes": { "type": "integer", "minimum": 15, "maximum": 60 },
              "emphasis": { "type": "string", "enum": ["Spinta", "Tirata", "Gambe", "Core", "Cardio", "Mobilità", "Full body"] },
              "warmupMinutes": { "type": "integer", "minimum": 3, "maximum": 10 },
              "exercises": {
                "type": "array",
                "minItems": 3,
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["exerciseId", "sets", "repsMin", "repsMax", "seconds", "restSeconds", "reserveReps"],
                  "properties": {
                    "exerciseId": { "type": "string", "enum": ["incline_pushup", "floor_pushup", "pike_pushup", "shoulder_tap", "band_lateral_raise", "dumbbell_lateral_raise", "chest_press_machine", "shoulder_press_machine", "cable_chest_press", "smith_shoulder_press", "band_row", "dumbbell_row", "band_reverse_fly", "band_curl", "lat_machine_neutral", "cable_low_row", "bodyweight_isometric_row", "reverse_snow_angel", "bodyweight_squat", "assisted_reverse_lunge", "glute_bridge", "calf_raise", "leg_press_machine", "leg_extension_machine", "leg_curl_machine", "smith_squat", "plank", "side_plank", "hollow_hold", "dead_bug", "cable_pallof_press", "fast_march", "side_step", "rower_intervals", "elliptical_intervals", "treadmill_intervals", "bike_intervals", "thoracic_mobility"] },
                    "sets": { "type": "integer", "minimum": 1, "maximum": 5 },
                    "repsMin": { "type": ["integer", "null"], "minimum": 1, "maximum": 30 },
                    "repsMax": { "type": ["integer", "null"], "minimum": 1, "maximum": 40 },
                    "seconds": { "type": ["integer", "null"], "minimum": 10, "maximum": 180 },
                    "restSeconds": { "type": "integer", "minimum": 15, "maximum": 180 },
                    "reserveReps": { "type": ["integer", "null"], "minimum": 0, "maximum": 5 }
                  }
                }
              },
              "finisher": { "type": ["string", "null"], "maxLength": 400 }
            }
          }
        }
      }
    }
  }
}